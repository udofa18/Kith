{
  "entities": {
    "User": {
      "title": "User",
      "description": "Platform user profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "bio": { "type": "string" },
        "location": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "githubUrl": { "type": "string" },
        "profileImage": { "type": "string" },
        "experienceLevel": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced"] },
        "userType": { "type": "string", "enum": ["Developer", "Buyer", "Both"] },
        "intent": { "type": "array", "items": { "type": "string" } },
        "interests": { "type": "array", "items": { "type": "string" } },
        "onboardingStep": { "type": "number" },
        "onboardingCompleted": { "type": "boolean" },
        "totalSales": { "type": "number" },
        "totalImpressions": { "type": "number" },
        "xp": { "type": "number" },
        "badges": { "type": "array", "items": { "type": "string" } },
        "dailyGiftingRemaining": { "type": "number" },
        "lastGiftingReset": { "type": "string", "format": "date-time" },
        "settings": {
          "type": "object",
          "properties": {
            "notifications": { "type": "boolean" },
            "theme": { "type": "string", "enum": ["light", "dark", "system"] },
            "layout": { "type": "string", "enum": ["compact", "comfortable"] },
            "isPrivate": { "type": "boolean" },
            "focusMode": { "type": "boolean" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "email"]
    },
    "Post": {
      "title": "Post",
      "description": "Developer social post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "authorXp": { "type": "number" },
        "communityId": { "type": "string" },
        "content": { "type": "string" },
        "codeSnippet": { "type": "string" },
        "language": { "type": "string" },
        "media": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["image", "video", "gif"] },
              "url": { "type": "string" }
            }
          }
        },
        "poll": {
          "type": "object",
          "properties": {
            "question": { "type": "string" },
            "options": { 
              "type": "array", 
              "items": {
                "type": "object",
                "properties": {
                  "text": { "type": "string" },
                  "votes": { "type": "number" }
                }
              }
            },
            "expiresAt": { "type": "string", "format": "date-time" },
            "voters": { "type": "array", "items": { "type": "string" } }
          }
        },
        "githubLink": { "type": "string" },
        "hashtags": { "type": "array", "items": { "type": "string" } },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "xpValue": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorUid", "content", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Post comment",
      "type": "object",
      "properties": {
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "content": { "type": "string" },
        "likesCount": { "type": "number" },
        "repliesCount": { "type": "number" },
        "replyToId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorUid", "content", "createdAt"]
    },
    "XPTransaction": {
      "title": "XPTransaction",
      "description": "Record of XP gifting",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "amount": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "receiverId", "amount", "timestamp"]
    },
    "Category": {
      "title": "Category",
      "description": "Category for organizing community channels",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "order"]
    },
    "Challenge": {
      "title": "Challenge",
      "description": "Coding challenge",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "creatorUid": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] },
        "deadline": { "type": "string", "format": "date-time" },
        "rewardXP": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["creatorUid", "title", "description", "deadline", "rewardXP"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Challenge submission",
      "type": "object",
      "properties": {
        "challengeId": { "type": "string" },
        "userUid": { "type": "string" },
        "githubRepo": { "type": "string" },
        "demoUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Accepted", "Rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["challengeId", "userUid", "githubRepo"]
    },
    "Article": {
      "title": "Article",
      "description": "Long-form written article or draft",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "coverImage": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "readingTime": { "type": "number" },
        "viewsCount": { "type": "number" },
        "likesCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "publishedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorUid", "title", "content", "status", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Marketplace product listing (Ebooks, Courses, Assets, etc.)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "creatorUid": { "type": "string" },
        "creatorName": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "productType": { "type": "string", "enum": ["ebook", "music", "course", "art", "video", "asset", "app"] },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "price": { "type": "number" },
        "fileUrl": { "type": "string", "description": "Secure link to the digital file" },
        "demoUrl": { "type": "string", "description": "Live demo or preview link" },
        "previewImage": { "type": "string" },
        "previewImages": { "type": "array", "items": { "type": "string" } },
        "previewVideo": { "type": "string" },
        "metadata": {
          "type": "object",
          "description": "Type-specific metadata (e.g. pages for ebook, duration for music)",
          "properties": {
            "pageCount": { "type": "number" },
            "duration": { "type": "string" },
            "format": { "type": "string" },
            "lessonsCount": { "type": "number" },
            "resolution": { "type": "string" }
          }
        },
        "impressions": { "type": "number" },
        "salesCount": { "type": "number" },
        "likes": { "type": "number" },
        "avgRating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["creatorUid", "title", "productType", "price"]
    },
    "Review": {
      "title": "Review",
      "description": "Component review",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "rating"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Record of a product purchase",
      "type": "object",
      "properties": {
        "buyerUid": { "type": "string" },
        "productId": { "type": "string" },
        "amount": { "type": "number" },
        "stripeSessionId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["buyerUid", "productId", "amount"]
    },
    "Hashtag": {
      "title": "Hashtag",
      "description": "Trending hashtag tracking",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "count": { "type": "number" },
        "lastUsed": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "count", "lastUsed"]
    },
    "Message": {
      "title": "Message",
      "description": "Direct message between users",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "read": { "type": "boolean" },
        "conversationId": { "type": "string" }
      },
      "required": ["senderId", "receiverId", "content", "createdAt", "conversationId"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Chat conversation between two users",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "unreadCount": { "type": "object" }
      },
      "required": ["participants", "lastMessageAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderPhoto": { "type": "string" },
        "type": { "type": "string", "enum": ["like", "comment", "mention", "message", "xp_gift", "challenge", "channel_mention", "purchase", "payout", "event_invite", "event_reminder", "system", "wallet"] },
        "category": { "type": "string", "enum": ["social", "community", "marketplace", "events", "earnings", "system"] },
        "priority": { "type": "string", "enum": ["low", "normal", "high"] },
        "actors": { 
          "type": "array", 
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "photo": { "type": "string" }
            }
          }
        },
        "mergedCount": { "type": "number" },
        "content": { "type": "string" },
        "relatedId": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientId", "type", "content", "createdAt"]
    },
    "Community": {
      "title": "Community",
      "description": "User-created community",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "creatorId": { "type": "string" },
        "image": { "type": "string" },
        "backdrop": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "memberCount": { "type": "number" },
        "isPrivate": { "type": "boolean" },
        "isPaid": { "type": "boolean" },
        "price": { "type": "number" },
        "website": { "type": "string" },
        "welcomeMessage": { "type": "string" },
        "membershipControl": {
          "type": "object",
          "properties": {
            "accessType": { "type": "string", "enum": ["public", "private", "invite-only"] },
            "approvalRequired": { "type": "boolean" },
            "onboardingQuestions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "question": { "type": "string" },
                  "type": { "type": "string", "enum": ["text", "multiple-choice"] },
                  "options": { "type": "array", "items": { "type": "string" } },
                  "required": { "type": "boolean" }
                }
              }
            },
            "memberVerificationRequired": { "type": "boolean" },
            "profileCompletionRequired": { "type": "boolean" },
            "autoRoles": { "type": "array", "items": { "type": "string" } }
          }
        },
        "xpMultiplier": { "type": "number" },
        "socials": {
          "type": "object",
          "properties": {
            "twitter": { "type": "string" },
            "discord": { "type": "string" },
            "github": { "type": "string" },
            "linkedin": { "type": "string" }
          }
        },
        "rules": { "type": "array", "items": { "type": "string" } },
        "stats": {
          "type": "object",
          "properties": {
            "postsCount": { "type": "number" },
            "messagesCount": { "type": "number" },
            "totalXp": { "type": "number" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "creatorId", "createdAt"]
    },
    "CommunityMember": {
      "title": "CommunityMember",
      "description": "Member of a community",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "admin", "moderator", "member"] },
        "status": { "type": "string", "enum": ["active", "muted", "restricted", "banned"] },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "xp": { "type": "number" },
        "joinedAt": { "type": "string", "format": "date-time" },
        "subscriptionId": { "type": "string" },
        "subscriptionStatus": { "type": "string" }
      },
      "required": ["userId", "role", "joinedAt"]
    },
    "Channel": {
      "title": "Channel",
      "description": "Community channel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["feed", "chat", "code", "resources", "announcements", "voice", "live"] },
        "voiceConfig": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["open", "stage", "private"] },
            "maxParticipants": { "type": "number" },
            "slowMode": { "type": "boolean" },
            "recordingEnabled": { "type": "boolean" }
          }
        },
        "isPremium": { "type": "boolean" },
        "isFrozen": { "type": "boolean" },
        "order": { "type": "number" },
        "categoryId": { "type": "string", "description": "ID of the category this channel belongs to" },
        "permissions": {
          "type": "object",
          "properties": {
            "view": { "type": "array", "items": { "type": "string" } },
            "post": { "type": "array", "items": { "type": "string" } },
            "manage": { "type": "array", "items": { "type": "string" } }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "type", "createdAt"]
    },
    "ChannelMessage": {
      "title": "ChannelMessage",
      "description": "Message in a community channel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "content": { "type": "string" },
        "codeSnippet": { "type": "string" },
        "language": { "type": "string" },
        "media": { "type": "array", "items": { "type": "string" } },
        "repliesCount": { "type": "number" },
        "replyToId": { "type": "string" },
        "threadId": { "type": "string" },
        "isThreadRoot": { "type": "boolean" },
        "reactions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "count": { "type": "number" },
              "uids": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorUid", "content", "createdAt"]
    },
    "Event": {
      "title": "Event",
      "description": "User or Community event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "banner": { "type": "string" },
        "hostId": { "type": "string" },
        "communityId": { "type": "string" },
        "eventType": { "type": "string", "enum": ["user", "community"] },
        "visibility": { "type": "string", "enum": ["public", "community"] },
        "isPaid": { "type": "boolean" },
        "price": { "type": "number" },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string" },
        "isOffline": { "type": "boolean" },
        "locationName": { "type": "string" },
        "locationAddress": { "type": "string" },
        "locationCoords": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "onlineType": { "type": "string", "enum": ["internal", "external"] },
        "externalPlatform": { "type": "string" },
        "externalUrl": { "type": "string" },
        "maxAttendees": { "type": "number" },
        "attendeeCount": { "type": "number" },
        "status": { "type": "string", "enum": ["upcoming", "live", "ended"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "hostId", "eventType", "visibility", "startDate", "endDate", "timezone", "status", "createdAt"]
    },
    "EventRegistration": {
      "title": "EventRegistration",
      "description": "Record of a user registering for an event",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "eventId": { "type": "string" },
        "paid": { "type": "boolean" },
        "amount": { "type": "number" },
        "registeredAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "eventId", "registeredAt"]
    },
    "EventSession": {
      "title": "EventSession",
      "description": "Live session state for an event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventId": { "type": "string" },
        "status": { "type": "string", "enum": ["waiting", "live", "ended"] },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "activePollId": { "type": "string" },
        "spotlightParticipantId": { "type": "string" }
      },
      "required": ["eventId", "status"]
    },
    "SessionParticipant": {
      "title": "SessionParticipant",
      "description": "Participant in a live session",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["host", "participant"] },
        "joinedAt": { "type": "string", "format": "date-time" },
        "isMuted": { "type": "boolean" },
        "cameraOff": { "type": "boolean" },
        "handRaised": { "type": "boolean" }
      },
      "required": ["userId", "role", "joinedAt"]
    },
    "SessionMessage": {
      "title": "SessionMessage",
      "description": "Chat message in a live session",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "content", "createdAt"]
    },
    "SessionPoll": {
      "title": "SessionPoll",
      "description": "Poll in a live session",
      "type": "object",
      "properties": {
        "question": { "type": "string" },
        "options": { 
          "type": "array", 
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "votes": { "type": "number" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "voters": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["question", "options", "createdAt"]
    },
    "SessionQuestion": {
      "title": "SessionQuestion",
      "description": "Q&A question in a live session",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isPinned": { "type": "boolean" },
        "upvotes": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["userId", "content", "createdAt"]
    },
    "CommunityInvite": {
      "title": "CommunityInvite",
      "description": "Shareable invite link for a community",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "communityId": { "type": "string" },
        "creatorId": { "type": "string" },
        "code": { "type": "string" },
        "uses": { "type": "number" },
        "maxUses": { "type": "number" },
        "rewardXp": { "type": "number" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["communityId", "creatorId", "code"]
    },
    "CommunityReport": {
      "title": "CommunityReport",
      "description": "User report for moderation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "communityId": { "type": "string" },
        "reporterId": { "type": "string" },
        "targetId": { "type": "string" },
        "reason": { "type": "string" },
