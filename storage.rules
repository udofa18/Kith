rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Paid product files. Creators upload here. Nobody reads directly:
    // buyers get short-lived signed URLs from the server after a purchase is verified.
    match /private_products/{userId}/{allPaths=**} {
      allow read: if false;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /{folder}/{userId}/{allPaths=**} {
      allow read: if folder != 'private_products';
      allow write: if request.auth != null && (
        (folder in ["avatars", "products", "previews", "posts", "editor", "article_covers", "statuses", "messages"] && request.auth.uid == userId) ||
        (folder == "channels" && request.auth.uid != null) || // More permissive for now, can refine match
        (folder == "communities" && request.auth.uid != null)
      );
    }
    match /{allPaths=**} {
      allow read: if !resource.name.matches('private_products/.*');
      allow write: if request.auth != null && (request.resource == null || !request.resource.name.matches('private_products/.*'));
    }
  }
}
