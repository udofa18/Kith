# .env.example
GEMINI_API_KEY=
APP_URL=
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# Payments. Stripe is the active provider (Connect for sellers, Checkout for buyers).
# Use test keys (sk_test_) until you go live.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint (from `stripe listen` locally, or the Stripe dashboard)
STRIPE_WEBHOOK_SECRET=
# Paystack is dormant. Only used when PAYMENT_PROVIDER=paystack.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Platform commission in basis points (1000 = 10%)
PLATFORM_FEE_BPS=1000
# Days a sale stays on hold before the creator can withdraw it (covers refunds)
PAYOUT_HOLD_DAYS=7
# Firebase Storage bucket for private product files (signed download URLs are issued from here)
FIREBASE_STORAGE_BUCKET=gen-lang-client-0475896362.firebasestorage.app
# Server-only Firebase Admin credential: the service account JSON on one line.
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Used to verify ID tokens and write Firestore from payment webhooks.
FIREBASE_SERVICE_ACCOUNT=

# LiveKit
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VITE_LIVEKIT_URL=
VITE_GOOGLE_MAPS_API_KEY=

# Supabase (Postgres database — Firebase Auth stays on Firebase)
VITE_SUPABASE_URL=
# Browser key: the publishable/anon key (sb_publishable_... or the legacy anon JWT).
# Never put the secret/service-role key here; the browser will reject it.
VITE_SUPABASE_ANON_KEY=
# Server-only key (never exposed to the browser).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# Migration phase: firestore | dual_write | supabase_reads | supabase
VITE_DB_PHASE=dual_write
# Comma-separated tables to read from Supabase during dual_write phase
VITE_SUPABASE_READ_COLLECTIONS=notifications,hashtags,user_interests,user_engagement_profiles
