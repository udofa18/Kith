# .env.example
GEMINI_API_KEY=
APP_URL=
VITE_STRIPE_PUBLISHABLE_KEY=

# Payments. Paystack is the active provider (NGN and USD checkout). Stripe remains wired for
# in-flight payments and future payouts, but its checkout and payout UI show "Coming soon".
# Use test keys (sk_test_) until you go live.
PAYMENT_PROVIDER=paystack
# Stripe is marked coming soon in `api/_lib/paymentProviders.ts`. Keep these for when it returns.
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint (from `stripe listen` locally, or the Stripe dashboard)
STRIPE_WEBHOOK_SECRET=
# Paystack is enabled when PAYSTACK_SECRET_KEY is set. Both providers collect into the platform
# account; creator withdrawals stay on Stripe Connect.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Must match the key: test or live. Leave empty to infer from the key prefix.
PAYSTACK_MODE=
# Currencies this Paystack merchant account may charge. This account is approved for NGN and USD.
# Comma separated; default NGN,USD.
PAYSTACK_CURRENCIES=NGN,USD
# Current webhook signing secret (`whsec_...`, comma separated during rotation). Used for the
# Paystack-Signature header. The legacy x-paystack-signature header still verifies with the secret key.
PAYSTACK_WEBHOOK_SECRET=
# Optional public origin for Paystack redirects when it differs from APP_URL (e.g. a tunnel).
PAYSTACK_CALLBACK_URL=
# Platform commission in basis points (1000 = 10%)
PLATFORM_FEE_BPS=1000
# Days a sale stays on hold before the creator can withdraw it (covers refunds)
PAYOUT_HOLD_DAYS=7
# Firebase Storage bucket for private product files (signed download URLs are issued from here)
FIREBASE_STORAGE_BUCKET=gen-lang-client-0475896362.firebasestorage.app
# Server-only Firebase Admin credential: the service account JSON on one line.
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Used to verify ID tokens and write Firestore from payment webhooks.
FIREBASE_SERVICE_ACCOUNT=

# LiveKit
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VITE_LIVEKIT_URL=
VITE_GOOGLE_MAPS_API_KEY=

# Supabase (Postgres database — Firebase Auth stays on Firebase)
VITE_SUPABASE_URL=
# Browser key: the publishable/anon key (sb_publishable_... or the legacy anon JWT).
# Never put the secret/service-role key here; the browser will reject it.
VITE_SUPABASE_ANON_KEY=
# Server-only key (never exposed to the browser).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# Migration phase: firestore | dual_write | supabase_reads | supabase
VITE_DB_PHASE=dual_write
# Comma-separated tables to read from Supabase during dual_write phase
VITE_SUPABASE_READ_COLLECTIONS=notifications,hashtags,user_interests,user_engagement_profiles
