{
  "crons": [
    {
      "path": "/api/payments/community/reconcile",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/media/feed/cleanup",
      "schedule": "30 4 * * *"
    }
  ],
  "functions": {
    "api/media/feed/[action].ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/rss"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
